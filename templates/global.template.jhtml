    <meta charset="UTF-8">
    <title>{snippet} {JuliaPagekit.page-title}</title>
    <meta name="description" content="{JuliaPagekit.description}">
    {JuliaPagekit.style}
</head>
<body>
    {JuliaPagekit.modified}
